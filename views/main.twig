{% extends "layout.twig" %}
{% import "macros.twig" as m %}

{% block content %}
<div class="d-flex flex-wrap g-3 mt-2" style="gap: 15px;">
    
    {% for object in space_objects %}
        <div class="col d-flex align-items-stretch">
            <div class="card h-100 w-100 shadow-sm border p-2 position-relative bg-white rounded">
                
                {% if is_logged %}
                    <div class="position-absolute d-flex gap-1" style="right: 8px; top: 8px; z-index: 10;">
                        <a href="/space-object/{{ object.id }}/edit" class="btn btn-info text-white p-0 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="fas fa-edit"></i>
                        </a>
                        <form action="/space-object/{{ object.id }}/delete" method="POST" class="m-0" onsubmit="return confirm('Вы уверены, что хотите удалить объект {{ object.title }}?');">
                            <button type="submit" class="btn btn-danger p-0 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="fas fa-times"></i>
                            </button>
                        </form>
                    </div>
                {% endif %}

                <div class="img-thumbnail mb-2" style="width: 100%; height: 160px; overflow:hidden; border: none; padding: 0;">
                    <img src="{{ object.image }}" alt="{{ object.title }}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px;">
                </div>

                <div class="d-flex flex-column mt-auto text-center">
                    <a class="btn btn-primary btn-sm mb-1 w-100" href="/space-object/{{ object.id }}" role="button">
                    {{ object.title }}
                    </a>
                <div class="d-flex justify-content-center gap-2 small">
                    <a class="btn btn-link btn-sm p-0 text-decoration-none" href="/space-object/{{ object.id }}?show=image" role="button">Картинка</a>
                    <a class="btn btn-link btn-sm p-0 text-decoration-none" href="/space-object/{{ object.id }}?show=info" role="button">Описание</a>
                </div>
            </div>

            </div>
        </div>
    {% else %}
        <div class="col-12">
            <div class="alert alert-warning w-100 text-center">
                Объекты пока не добавлены в базу данных.
            </div>
        </div>
    {% endfor %}
    
</div>
{% endblock %}