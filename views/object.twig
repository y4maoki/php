{% extends "layout.twig" %}

{% block content %}
<div class="mt-2">
    {# Кнопка назад #}
    <a href="/" class="btn btn-secondary btn-sm mb-3">
        <i class="fas fa-arrow-left"></i> Назад на главную
    </a>

    <h1 class="text-primary fw-normal mb-2" style="font-size: 2.3rem;">{{ title }}</h1>
    
    <ul class="nav nav-pills mt-3 mb-3">
      <li class="nav-item">
        <a class="nav-link {{ show == 'image' ? 'active' : '' }}" href="/space-object/{{ id }}?show=image">Картинка</a>
      </li>
      <li class="nav-item">
        <a class="nav-link {{ show == 'info' ? 'active' : '' }}" href="/space-object/{{ id }}?show=info">Описание</a>
      </li>
    </ul>

    {% if show == 'image' %}
        <div class="space-content">
            <div class="border p-2 mt-3 bg-white rounded shadow-sm" style="display: inline-block; max-width: 100%;">
                <img src="{{ image }}" alt="{{ title }}" class="img-fluid rounded" style="display: block; max-width: 100%; max-height: 500px; object-fit: contain;">
            </div>
        </div>
    {% elseif show == 'info' %}
        <div class="space-content">
            <div class="border p-4 mt-3 bg-white rounded shadow-sm text-secondary" style="line-height: 1.6; font-size: 1.05rem;">
                {{ info|raw }}
            </div>
        </div>
    {% else %}
        <div class="text-muted mt-3" style="font-size: 1.1rem;">
            Выберите сверху, что хотите посмотреть :)
        </div>
    {% endif %}
</div>
{% endblock %}