<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css" rel="stylesheet" />
    <title>{{ title }}</title>
</head>
<body>
    <nav class="navbar navbar-expand-lg bg-light shadow-sm">
        <div class="container">
            <a class="navbar-brand text-warning" href="/">
                <i class="fa-solid fa-sun fa-lg"></i>
            </a>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item">
                        <a class="nav-link fw-semibold" href="/">Главная</a>
                    </li>
                    {% for type in types %}
                        <li class="nav-item">
                           <a class="nav-link" href="/?type_id={{ type.id }}">{{ type.name|title }}</a>
                        </li>
                    {% endfor %}
                </ul>
                
                <ul class="navbar-nav align-items-center flex-row gap-2 ms-4">
                    <li class="nav-item">
                        <a class="nav-link px-2" href="/search">Поиск</a>
                    </li>
                    {% if is_logged %}
                        <li class="nav-item">
                            <a class="nav-link px-2" href="/space-object/create">Добавить</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-2" href="/space-type/create">Создать тип</a>
                        </li>
                        <li class="nav-item ms-2">
                            <form action="/logout" method="GET" class="d-inline">
                                <button type="submit" class="btn btn-link nav-link border-0 p-0" style="display: inline;">
                                    Выйти
                                </button>
                            </form>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    
    <div class="container mt-4">
        <div class="row">
            
            <div class="col-md-9">
                {% block content %} 
                {% endblock %}
            </div>


            <div class="col-md-3">
                <h6 class="card-title text-muted mb-3">Последние страницы:</h6>
                <ul class="list-group list-group-flush" style="font-size: 0.85rem;">
                    {% for link in history %}
                        <li class="list-group-item p-1 border-0" style="background: transparent;">
                            <a href="{{ link }}" class="text-decoration-none d-block text-break" title="{{ link }}">
                                {{ link }}
                            </a>
                        </li>
                    {% else %}
                        <li class="list-group-item text-muted small border-0" style="background: transparent;">История пуста</li>
                    {% endfor %}
                </ul>
            </div>        
        </div>
    </div>
</body>
</html>